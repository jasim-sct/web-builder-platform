{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true
  },
  "include": ["scripts/**/*", "tooling/**/*", "*.mjs", "*.js", "*.ts"],
  "exclude": ["node_modules", "apps", "packages"]
}
